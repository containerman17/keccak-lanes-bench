+// Copyright (C) 2026, Ava Labs, Inc. All rights reserved.
+// See the file LICENSE.md for licensing terms.
+
+//! Batched Keccak-256 with runtime-selected x86 vector kernels.
+
+use sha3::{Digest, Keccak256};
+
+/// Hashes messages in input order, including messages with different lengths.
+pub(super) fn hash_many(msgs: &[&[u8]], out: &mut [[u8; 32]]) {
+    assert_eq!(msgs.len(), out.len());
+    #[cfg(target_arch = "x86_64")]
+    if x86::hash_many(msgs, out) {
+        return;
+    }
+    scalar(msgs, out);
+}
+
+fn scalar(msgs: &[&[u8]], out: &mut [[u8; 32]]) {
+    for (message, digest) in msgs.iter().zip(out) {
+        *digest = Keccak256::digest(message).into();
+    }
+}
+
+// The vector intrinsics require unsafe code. Runtime feature detection protects every
+// kernel call; the sponge supplies complete blocks and owns the state buffers.
+#[cfg(target_arch = "x86_64")]
+#[allow(unsafe_code)]
+#[allow(
+    clippy::indexing_slicing,
+    clippy::arithmetic_side_effects,
+    clippy::disallowed_methods,
+    reason = "Fixed-width kernel indices and sponge block ranges are bounded by array sizes and validated lengths."
+)]
