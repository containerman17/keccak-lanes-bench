diff --git a/storage/src/hashers/batched.rs b/storage/src/hashers/batched.rs
new file mode 100644
index 000000000..61625a594
--- /dev/null
+++ b/storage/src/hashers/batched.rs
@@ -0,0 +1,447 @@
+// Copyright (C) 2026, Ava Labs, Inc. All rights reserved.
+// See the file LICENSE.md for licensing terms.
+
+//! Storage hashing with level batches or parallel branches. Account nodes use the stock path.
+
+use std::sync::OnceLock;
+
+use crate::{
+    Child, HashType, HashableShunt, MaybePersistedNode, Node, Path, PathComponent, SharedNode,
+};
+
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct Mode {
+    pub(crate) lanes: bool,
+    pub(crate) parallel: bool,
+}
+
+pub(crate) fn mode() -> Mode {
+    static MODE: OnceLock<Mode> = OnceLock::new();
+    *MODE.get_or_init(|| match std::env::var("FIREWOOD_HASH_MODE").as_deref() {
+        Ok("lanes") => Mode {
+            lanes: true,
+            parallel: false,
+        },
+        Ok("par") => Mode {
+            lanes: false,
+            parallel: true,
+        },
+        Ok("lanes+par") => Mode {
+            lanes: true,
+            parallel: true,
+        },
+        _ => Mode {
+            lanes: false,
+            parallel: false,
+        },
+    })
+}
+
+struct Entry {
+    node: Node,
+    path: Path,
+    parent: Option<(usize, PathComponent)>,
+}
+
+/// Lane batches process independent nodes deepest first. Parallel mode splits
+/// dirty branch children using the caller's Rayon pool.
+#[expect(
+    clippy::disallowed_methods,
+    reason = "chunk size is a nonzero constant"
+)]
+pub(crate) fn hash_subtrie(node: Node, path: Path, mode: Mode) -> (MaybePersistedNode, HashType) {
+    if mode.parallel {
+        return hash_depth_first(node, path, true, mode.lanes);
+    }
+
+    let mut levels = vec![vec![Entry {
+        node,
+        path,
+        parent: None,
+    }]];
+    loop {
+        let mut next = Vec::new();
+        for (parent, entry) in levels
+            .last_mut()
+            .expect("root level")
+            .iter_mut()
+            .enumerate()
+        {
+            if let Node::Branch(branch) = &mut entry.node {
+                for (nibble, child) in &mut branch.children {
+                    if matches!(child, Some(Child::Node(_))) {
+                        let Some(Child::Node(node)) = child.take() else {
+                            unreachable!()
+                        };
+                        let mut path = entry.path.clone();
+                        path.0.extend_from_slice(&branch.partial_path.0);
+                        path.0.push(nibble.as_u8());
+                        next.push(Entry {
+                            node,
+                            path,
+                            parent: Some((parent, nibble)),
+                        });
+                    }
+                }
+            }
+        }
+        if next.is_empty() {
+            break;
+        }
+        levels.push(next);
+    }
+
+    while let Some(mut level) = levels.pop() {
+        // Chunking bounds temporary RLP buffers.
+        let hashes: Vec<HashType> = level
+            .chunks(256)
+            .flat_map(|chunk| hash_level(chunk, mode.lanes))
+            .collect();
+        for (entry, hash) in level.drain(..).zip(hashes) {
+            let persisted: MaybePersistedNode = SharedNode::new(entry.node).into();
+            if let Some((parent, nibble)) = entry.parent {
+                let parent = &mut levels
+                    .last_mut()
+                    .expect("parent level")
+                    .get_mut(parent)
+                    .expect("recorded parent index")
+                    .node;
+                let Node::Branch(parent) = parent else {
+                    unreachable!()
+                };
+                parent.children[nibble] = Some(Child::MaybePersisted(persisted, hash));
+            } else {
+                return (persisted, hash);
+            }
+        }
+    }
+    unreachable!("root is returned")
+}
+
+// Each task uses an iterative walk. Only its caller can create tasks, so a
+// path with arbitrarily many branch levels cannot recurse through Rayon.
+fn hash_depth_first(
+    mut node: Node,
+    mut path: Path,
+    mut may_split: bool,
+    lanes: bool,
+) -> (MaybePersistedNode, HashType) {
+    let mut parents = Vec::new();
+    loop {
+        if may_split && hash_parallel_children(&mut node, &path, lanes) {
+            may_split = false;
+        } else if lanes {
+            return hash_subtrie(
+                node,
+                path,
+                Mode {
+                    lanes: true,
+                    parallel: false,
+                },
+            );
+        }
+        if let Node::Branch(branch) = &mut node {
+            let dirty = branch
+                .children
+                .iter_mut()
+                .find(|(_, child)| matches!(child, Some(Child::Node(_))));
+            if let Some((nibble, child)) = dirty {
+                let Some(Child::Node(child)) = child.take() else {
+                    unreachable!()
+                };
+                let prefix_len = path.len();
+                path.0.extend_from_slice(&branch.partial_path.0);
+                path.0.push(nibble.as_u8());
+                parents.push((node, nibble, prefix_len));
+                node = child;
+                continue;
+            }
+        }
+        let hash = crate::hashednode::hash_node(&node, &path);
+        let persisted = SharedNode::new(node).into();
+        let Some((mut parent, nibble, prefix_len)) = parents.pop() else {
+            return (persisted, hash);
+        };
+        let Node::Branch(branch) = &mut parent else {
+            unreachable!()
+        };
+        branch.children[nibble] = Some(Child::MaybePersisted(persisted, hash));
+        path.0.truncate(prefix_len);
+        node = parent;
+    }
+}
+
+fn hash_parallel_children(node: &mut Node, path: &Path, lanes: bool) -> bool {
+    let Node::Branch(branch) = node else {
+        return false;
+    };
+    let dirty: Vec<_> = branch
+        .children
+        .iter()
+        .filter_map(|(_, child)| {
+            if let Some(Child::Node(node)) = child {
+                Some(node)
+            } else {
+                None
+            }
+        })
+        .collect();
+    if dirty.len() < 2 || !enough_dirty_work(dirty) {
+        return false;
+    }
+    let mut prefix = path.clone();
+    prefix.0.extend_from_slice(&branch.partial_path.0);
+    let mut jobs = Vec::new();
+    for (nibble, child) in &mut branch.children {
+        if matches!(child, Some(Child::Node(_))) {
+            let Some(Child::Node(node)) = child.take() else {
+                unreachable!()
+            };
+            let mut path = prefix.clone();
+            path.0.push(nibble.as_u8());
+            jobs.push((nibble, node, path));
+        }
+    }
+    let mut results = vec![None; jobs.len()];
+    rayon::scope(|scope| {
+        for ((nibble, node, path), output) in jobs.into_iter().zip(&mut results) {
+            scope.spawn(move |_| {
+                *output = Some((nibble, hash_depth_first(node, path, false, lanes)));
+            });
+        }
+    });
+    for result in results {
+        let (nibble, (node, hash)) = result.expect("scope joins every child");
+        branch.children[nibble] = Some(Child::MaybePersisted(node, hash));
+    }
+    true
+}
+
+fn enough_dirty_work(mut pending: Vec<&Node>) -> bool {
+    for _ in 0..512 {
+        let Some(node) = pending.pop() else {
+            return false;
+        };
+        if let Node::Branch(branch) = node {
+            pending.extend(branch.children.iter().filter_map(|(_, child)| {
+                if let Some(Child::Node(node)) = child {
+                    Some(node)
+                } else {
+                    None
+                }
+            }));
+        }
+    }
+    true
+}
+
+fn hash_level(level: &[Entry], lanes: bool) -> Vec<HashType> {
+    if !lanes {
+        return level
+            .iter()
+            .map(|entry| crate::hashednode::hash_node(&entry.node, &entry.path))
+            .collect();
+    }
+    let mut encoded = Vec::with_capacity(level.len());
+    let mut internal = Vec::new();
+    let mut internal_nodes = Vec::new();
+    for (index, entry) in level.iter().enumerate() {
+        let mut bytes = Vec::new();
+        super::ethhash::write_with_digest(
+            &HashableShunt::from_node(entry.path.as_components(), &entry.node),
+            &mut bytes,
+            |preimage| {
+                // A non-account node has at most one internal hash: its branch
+                // RLP when an extension path references that branch.
+                internal.push(preimage.to_vec());
+                internal_nodes.push(index);
+                [0; 32].into()
+            },
+        );
+        encoded.push(bytes);
+    }
+    if !internal.is_empty() {
+        let inputs: Vec<_> = internal.iter().map(Vec::as_slice).collect();
+        let mut hashes = vec![[0; 32]; inputs.len()];
+        super::lanes::hash_many(&inputs, &mut hashes);
+        for (index, hash) in internal_nodes.into_iter().zip(hashes) {
+            let entry = level.get(index).expect("recorded node index");
+            let bytes = encoded.get_mut(index).expect("one buffer per node");
