+    )]
+    fn parallel_children_match_serial_with_dirty_descendants() {
+        let path = Path::from_nibbles_iterator(std::iter::repeat_n(1, 65));
+        let leaves: Vec<_> = (0..4096)
+            .map(|index: u64| {
+                Node::Leaf(LeafNode {
+                    partial_path: Path::from_nibbles_iterator([2, 3, 4].into_iter()),
+                    value: index.to_be_bytes().into(),
+                })
+            })
+            .collect();
+        let mut layer = leaves;
+        while layer.len() > 1 {
+            layer = layer
+                .chunks(16)
+                .map(|nodes| {
+                    let mut children = Children::new();
+                    for ((_, child), node) in (&mut children).into_iter().zip(nodes) {
+                        *child = Some(Child::Node(node.clone()));
+                    }
+                    Node::Branch(Box::new(BranchNode {
+                        partial_path: Path::default(),
+                        value: None,
+                        children,
+                    }))
+                })
+                .collect();
+        }
+        let root = layer.pop().expect("root");
+        let stock = hash_subtrie(
+            root.clone(),
+            path.clone(),
+            Mode {
+                lanes: false,
+                parallel: false,
+            },
+        )
+        .1;
+        for mode in [
+            Mode {
+                lanes: true,
+                parallel: false,
+            },
+            Mode {
+                lanes: false,
+                parallel: true,
+            },
+            Mode {
+                lanes: true,
+                parallel: true,
+            },
+        ] {
