index 000000000..8aa021869
--- /dev/null
+++ b/firewood/examples/hash_account.rs
@@ -0,0 +1,145 @@
+// Copyright (C) 2026, Ava Labs, Inc. All rights reserved.
+// See the file LICENSE.md for licensing terms.
+
+//! Deterministic single-account proposal workload. Create once, then copy the
+//! closed database before each mode's measure run.
+
+use clap::{Parser, ValueEnum};
+use firewood::api::{Db as _, Proposal as _};
+use firewood::db::{BatchOp, Db, DbConfig};
+use sha3::{Digest, Keccak256};
+use std::{collections::HashSet, error::Error, path::PathBuf, time::Instant};
+
+#[derive(Clone, Debug, ValueEnum)]
+enum Action {
+    Create,
+    Measure,
+}
+
+#[derive(Debug, Parser)]
+struct Args {
+    #[arg(value_enum)]
+    action: Action,
+    #[arg(long)]
+    path: PathBuf,
+    #[arg(long, default_value_t = 2_000_000)]
+    keys: usize,
+    #[arg(long, default_value_t = 38_400)]
+    dirty: usize,
+    #[arg(long, default_value_t = 10)]
+    blocks: usize,
+    #[arg(long, default_value_t = 100_000)]
+    load_batch: usize,
+}
+
+fn slot_key(index: usize) -> Vec<u8> {
+    let mut key = vec![0x42; 32];
+    key.extend_from_slice(&Keccak256::digest((index as u64).to_be_bytes()));
+    key
+}
+
+fn account_value() -> Vec<u8> {
+    let mut rlp = rlp::RlpStream::new_list(4);
+    rlp.append(&0u64);
+    rlp.append(&0u64);
+    rlp.append(&Keccak256::digest([0x80]).as_slice());
+    rlp.append(&Keccak256::digest([]).as_slice());
+    rlp.out().to_vec()
+}
+
+fn value(index: usize, block: usize) -> Vec<u8> {
+    // A valid RLP scalar, without leading zero bytes.
+    rlp::encode(&(index as u64).wrapping_add(block as u64).wrapping_add(1)).to_vec()
+}
+
+fn main() -> Result<(), Box<dyn Error>> {
+    let args = Args::parse();
+    let blocks = u32::try_from(args.blocks)?;
+    assert!(args.keys > 0 && args.dirty <= args.keys && args.load_batch > 0 && args.blocks > 0);
+    let create = matches!(args.action, Action::Create);
+    if create && args.path.exists() {
+        return Err("create requires a new path".into());
+    }
+    if !create && !args.path.is_dir() {
+        return Err("measure requires an existing database directory".into());
+    }
+    let db = Db::new(
+        &args.path,
+        DbConfig::builder()
+            .node_hash_algorithm(firewood_storage::NodeHashAlgorithm::compile_option())
+            .build(),
+    )?;
+    println!(
+        "mode={} keys={} dirty={} blocks={}",
+        std::env::var("FIREWOOD_HASH_MODE").unwrap_or_else(|_| "stock".into()),
+        args.keys,
+        args.dirty,
+        args.blocks
+    );
+    if create {
+        let start = Instant::now();
+        db.propose(vec![BatchOp::Put {
+            key: vec![0x42; 32],
+            value: account_value(),
+        }])?
+        .commit()?;
+        for begin in (0..args.keys).step_by(args.load_batch) {
+            let end = begin.saturating_add(args.load_batch).min(args.keys);
+            let batch = (begin..end)
+                .map(|index| BatchOp::Put {
+                    key: slot_key(index),
+                    value: value(index, 0),
+                })
+                .collect::<Vec<_>>();
+            db.propose(batch)?.commit()?;
+            println!(
+                "loaded={end} elapsed_ms={:.3}",
+                start.elapsed().as_secs_f64() * 1000.0
+            );
+        }
+        println!(
+            "baseline_root={}",
+            hex::encode(db.root_hash().ok_or("missing root")?)
+        );
+    } else {
+        println!(
+            "baseline_root={}",
+            hex::encode(db.root_hash().ok_or("missing root")?)
+        );
+        let mut random = 0x1234_5678_9abc_def0u64;
+        let mut total_ms = 0.0;
+        for block in 1..=args.blocks {
+            let mut selected = HashSet::with_capacity(args.dirty);
+            let mut batch = Vec::with_capacity(args.dirty);
+            while batch.len() < args.dirty {
+                random ^= random << 13;
+                random ^= random >> 7;
+                random ^= random << 17;
+                let index = random
+                    .checked_rem(args.keys as u64)
+                    .expect("keys is nonzero") as usize;
+                if selected.insert(index) {
+                    batch.push(BatchOp::Put {
+                        key: slot_key(index),
+                        value: value(index, block),
+                    });
+                }
+            }
+            let start = Instant::now();
+            let proposal = db.propose(batch)?;
+            let propose_ms = start.elapsed().as_secs_f64() * 1000.0;
+            let start = Instant::now();
+            proposal.commit()?;
+            let commit_ms = start.elapsed().as_secs_f64() * 1000.0;
+            let block_ms = propose_ms + commit_ms;
+            total_ms += block_ms;
+            println!(
+                "block={block} propose_ms={propose_ms:.3} commit_ms={commit_ms:.3} total_ms={block_ms:.3} root={}",
+                hex::encode(db.root_hash().ok_or("missing root")?)
+            );
+        }
+        println!("mean_ms={:.3}", total_ms / f64::from(blocks));
+    }
+    db.close()?;
+    Ok(())
+}
