+        }
+    }
+
+    #[test]
+    fn deep_dirty_chain_hashes_on_small_stack() {
+        let mut expected = None;
+        for mode in [
+            Mode {
+                lanes: true,
+                parallel: false,
+            },
+            Mode {
+                lanes: false,
+                parallel: true,
+            },
+            Mode {
+                lanes: true,
+                parallel: true,
+            },
+        ] {
+            let mut node = Node::Leaf(LeafNode {
+                partial_path: Path::default(),
+                value: vec![7; 32].into_boxed_slice(),
+            });
+            for _ in 0..1024 {
+                let mut children = Children::new();
+                let (_, child) = children.iter_mut().next().expect("child slot");
+                *child = Some(Child::Node(node));
+                node = Node::Branch(Box::new(BranchNode {
+                    partial_path: Path::default(),
+                    value: Some(vec![3; 32].into_boxed_slice()),
+                    children,
+                }));
+            }
+            let path = Path::from_nibbles_iterator(std::iter::repeat_n(1, 65));
+            let (hashed_node, hash) = std::thread::Builder::new()
+                .stack_size(128 * 1024)
+                .spawn(move || hash_subtrie(node, path, mode))
+                .expect("spawn hashing thread")
+                .join()
+                .expect("iterative hashing must fit on a small stack");
+            if let Some(expected) = &expected {
+                assert_eq!(&hash, expected);
+            } else {
+                expected = Some(hash);
+            }
+            // Drop outside the small thread: node destruction is a separate path.
+            drop(hashed_node);
+        }
+    }
+}
