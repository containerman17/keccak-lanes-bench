+// Copyright (C) 2026, Ava Labs, Inc. All rights reserved.
+// See the file LICENSE.md for licensing terms.
+
+#![cfg(feature = "ethhash")]
+
+use firewood::api::{Db as _, Proposal as _};
+use firewood::db::{BatchOp, Db, DbConfig};
+use sha3::{Digest, Keccak256};
+use std::process::Command;
+
+fn slot(index: u64) -> Vec<u8> {
+    let mut key = vec![0x42; 32];
+    key.extend_from_slice(&Keccak256::digest(index.to_be_bytes()));
+    key
+}
+
+#[test]
+fn hash_mode_child() {
+    if std::env::var_os("FIREWOOD_HASH_CHILD").is_none() {
+        return;
+    }
+    let dir = tempfile::tempdir().unwrap();
+    let db = Db::new(
+        dir.path().join("db"),
+        DbConfig::builder()
+            .node_hash_algorithm(firewood_storage::NodeHashAlgorithm::compile_option())
+            .build(),
+    )
+    .unwrap();
+    let mut account = rlp::RlpStream::new_list(4);
+    account.append(&0u64);
+    account.append(&0u64);
+    account.append(&Keccak256::digest([0x80]).as_slice());
+    account.append(&Keccak256::digest([]).as_slice());
+    let stages = vec![
+        vec![BatchOp::Put {
+            key: vec![0x42; 32],
+            value: account.out().to_vec(),
+        }],
+        vec![BatchOp::Put {
+            key: slot(0),
+            value: rlp::encode(&1u64).to_vec(),
+        }],
+        (1..16384)
+            .map(|i| BatchOp::Put {
+                key: slot(i),
+                value: rlp::encode(&(i + 1)).to_vec(),
+            })
+            .collect(),
+        (0..16384)
+            .step_by(3)
+            .map(|i| BatchOp::Put {
+                key: slot(i),
+                value: rlp::encode(&(i + 9000)).to_vec(),
+            })
+            .collect(),
+        (1..16384)
+            .map(|i| BatchOp::Delete { key: slot(i) })
+            .collect(),
+        vec![BatchOp::Delete { key: slot(0) }],
+    ];
+    for batch in stages {
+        db.propose(batch).unwrap().commit().unwrap();
+        println!("ROOT {}", hex::encode(db.root_hash().unwrap()));
+    }
+    db.close().unwrap();
+}
+
+#[test]
+fn account_roots_match_in_every_hash_mode() {
+    let mut stock = None;
+    for mode in ["stock", "lanes", "par", "lanes+par"] {
+        let output = Command::new(std::env::current_exe().unwrap())
+            .args(["--exact", "hash_mode_child", "--nocapture"])
+            .env("FIREWOOD_HASH_CHILD", "1")
+            .env("FIREWOOD_HASH_MODE", mode)
+            .output()
+            .unwrap();
+        assert!(
+            output.status.success(),
+            "{mode}: {}\n{}",
+            String::from_utf8_lossy(&output.stdout),
+            String::from_utf8_lossy(&output.stderr)
+        );
+        let stdout = String::from_utf8(output.stdout).unwrap();
+        let roots: Vec<_> = stdout
+            .lines()
+            .filter_map(|line| line.strip_prefix("ROOT "))
+            .map(str::to_owned)
+            .collect();
+        assert_eq!(roots.len(), 6, "{stdout}");
+        if let Some(expected) = &stock {
+            assert_eq!(&roots, expected, "mode {mode}");
+        } else {
+            stock = Some(roots);
+        }
+    }
+}
